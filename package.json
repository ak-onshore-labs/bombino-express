{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev:client": "vite dev --port 5000",
    "dev": "cross-env NODE_OPTIONS=--import=./server/dns-ipv4first.mjs NODE_ENV=development tsx watch --clear-screen=false server/index.ts",
    "dev:noreload": "cross-env NODE_OPTIONS=--import=./server/dns-ipv4first.mjs NODE_ENV=development tsx server/index.ts",
    "build": "tsx script/build.ts",
    "start": "cross-env NODE_OPTIONS=--import=./server/dns-ipv4first.mjs NODE_ENV=production node dist/index.cjs",
    "check": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test \"server/**/*.test.ts\" \"shared/**/*.test.ts\" \"client/src/**/*.test.ts\"",
    "test:e2e": "tsx --test --test-concurrency=1 \"tests/e2e/**/*.e2e.ts\"",
    "bia:eval": "tsx scripts/bia-eval.ts",
    "db:push": "cross-env NODE_OPTIONS=--import=./server/dns-ipv4first.mjs drizzle-kit push"
  },
  "dependencies": {
