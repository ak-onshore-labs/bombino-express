[
  {
    "id": "docs-01-half-finished-ecommerce-signup",
    "module": "onboarding",
    "requires": ["onboarding"],
    "identity": "anon",
    "screen": { "surface": "signup", "step": "documents", "account": "ecommerce" },
    "signup": {
      "numbers": [
        { "kind": "pan", "document_no": "ABCPE1234K" },
        { "kind": "gstin", "document_no": "27ABCPE1234K1Z5" }
      ],
      "documents": [
        { "doc_slot": "pan_card", "ocr_status": "match" },
        { "doc_slot": "gst_certificate", "ocr_status": "unreadable" },
        { "doc_slot": "iec_certificate", "ocr_status": "skipped" }
      ]
    },
    "turns": ["What's left before my account can open?"],
    "expect": {
      "tools": ["get_signup_progress"],
      "cards": ["docStatus"],
      "contains": ["re:3 (out )?of (the )?4|three (out )?of (the )?four", "re:authori[sz]ation letter", "re:GST certificate"],
      "notContains": ["re:bypass"]
    }
  },
  {
    "id": "docs-02-bypassed-reads-as-on-file",
    "module": "onboarding",
    "requires": ["onboarding"],
    "identity": "anon",
    "screen": { "surface": "help" },
    "signup": {
      "numbers": [
        { "kind": "aadhaar", "document_no": "234123412346" },
        { "kind": "pan", "document_no": "ABCPE1234K" }
      ],
      "documents": [{ "doc_slot": "aadhaar_card", "ocr_status": "bypassed" }]
    },
    "turns": ["Did the documents for my signup go through?"],
    "expect": {
      "tools": ["get_signup_progress"],
      "cards": ["docStatus"],
      "contains": ["re:PAN"],
      "notContains": ["re:bypass|skipped|not (been )?verified|unverified|couldn.t be (checked|verified)"],
      "buttons": ["TAP_RESUME_SIGNUP:personal"]
    }
  },
  {
    "id": "docs-03-account-document-status",
    "module": "documents",
    "requires": ["documents"],
    "identity": "account",
    "screen": { "surface": "documents" },
    "turns": ["Are all my account documents in?"],
    "expect": {
      "tools": ["get_document_status"],
      "cards": ["docStatus"],
      "toolsNot": ["get_signup_progress"]
    }
  },
  {
    "id": "docs-04-guest-has-one-document",
    "module": "documents",
    "requires": ["documents"],
    "identity": "guest",
    "screen": { "surface": "help" },
    "turns": ["Is my ID document on file?"],
    "expect": {
      "toolsAny": ["get_my_kyc_status"],
      "notContains": ["re:bypass|unverified"]
    }
  },
  {
    "id": "docs-05-no-signup-yet",
    "module": "onboarding",
    "requires": ["onboarding"],
    "identity": "anon",
    "screen": { "surface": "signup", "step": "details", "account": "personal" },
    "turns": ["Which documents have I uploaded so far?"],
    "expect": {
      "tools": ["get_signup_progress"],
      "contains": ["re:nothing|haven.t|not yet|no (documents|numbers)|none"],
      "noCards": true
    }
  },
  {
    "id": "docs-06-quoted-unreadable",
    "module": "documents",
    "requires": ["documents"],
    "identity": "account",
    "screen": { "surface": "help" },
    "turns": ["My PAN upload says the document couldn't be read. What should I do?"],
    "expect": {
      "tools": ["explain_document_issue"],
      "contains": ["re:daylight|flat|flash|corners"],
      "notContains": ["re:your fault|you uploaded (it )?wrong"],
      "buttons": ["TAP_ACCOUNT_DOCUMENTS"]
    }
  },
  {
    "id": "docs-07-outage-is-not-a-bad-photo",
    "module": "documents",
    "requires": ["documents"],
    "identity": "anon",
    "screen": { "surface": "signup", "step": "documents", "account": "personal" },
    "turns": ["It says my Aadhaar couldn't be checked just now. Is my photo bad?"],
    "expect": {
      "toolsAny": ["explain_document_issue"],
      "contains": ["re:(few|couple of) minutes|try (uploading )?(it )?again", "re:not (a problem with|about) (the|your) (document|photo)|isn.t (a problem with|about) (the|your) (document|photo)|nothing wrong with"],
      "notContains": ["re:clearer photo|blur|glare"]
    }
  },
  {
    "id": "docs-08-ask-bia-on-wrong-document",
    "module": "documents",
    "identity": "anon",
    "screen": { "surface": "signup", "step": "documents", "account": "personal", "errorCode": "OCR_WRONG_DOCUMENT" },
    "turns": ["What went wrong with this upload?"],
    "expect": {
      "contains": ["re:(different|another|wrong|correct|right) (kind of |type of )?document|(asks|asking) for|type (required|needed|asked)"],
      "notContains": ["re:bypass|tamper|screenshot"]
    }
  },
  {
    "id": "docs-09-account-uploads-from-chat",
    "module": "documents",
    "requires": ["documents"],
    "identity": "account",
    "screen": { "surface": "help" },
    "turns": ["Can I upload a clearer photo of my PAN card right here?"],
    "expect": {
      "tools": ["offer_document_upload"],
      "cards": ["docUpload"],
      "notContains": ["re:(has|have|was|been) (now )?(been )?uploaded|i.ve uploaded|i uploaded|type (your|the) (pan|number) (here|in (the|this) chat)"]
    }
  },
  {
    "id": "docs-10-guest-replaces-id-from-chat",
    "module": "documents",
    "requires": ["documents"],
    "identity": "guest",
    "screen": { "surface": "help" },
    "turns": ["I'd like to replace my ID document here in the chat."],
    "expect": {
      "tools": ["offer_document_upload"],
      "cards": ["docUpload"],
      "notContains": ["re:(has|have|was|been) (now )?(been )?uploaded|i.ve uploaded|bypass|unverified"]
    }
  },
  {
    "id": "docs-11-signup-uploads-stay-on-signup",
    "module": "documents",
    "requires": ["documents"],
    "identity": "anon",
    "screen": { "surface": "signup", "step": "details", "account": "personal" },
    "turns": ["Can I just upload my Aadhaar to you here instead?"],
    "expect": {
      "contains": ["re:documents step|signup (screen|form|page)|on the signup"],
      "noCards": true
    }
  }
]
