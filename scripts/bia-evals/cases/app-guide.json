[
  {
    "id": "app-01-change-mobile-number",
    "module": "general",
    "identity": "account",
    "screen": { "surface": "help" },
    "turns": ["How do I change my mobile number?"],
    "expect": {
      "tools": ["get_app_help"],
      "contains": ["re:profile", "re:change number|new number|code"],
      "notContains": ["re:I('ll| will) (change|update)|I('ve| have) (changed|updated)"]
    }
  },
  {
    "id": "app-02-shipping-label",
    "module": "general",
    "identity": "anon",
    "screen": { "surface": "help" },
    "turns": ["Where can I download the shipping label for my parcel?"],
    "expect": {
      "tools": ["get_app_help"],
      "contains": ["re:label", "re:shipment|AWB|tracking"]
    }
  },
  {
    "id": "app-03-export-orders",
    "module": "general",
    "identity": "account",
    "screen": { "surface": "help" },
    "turns": ["Can I export all my shipments to a spreadsheet?"],
    "expect": {
      "tools": ["get_app_help"],
      "contains": ["re:export csv|csv"]
    }
  },
  {
    "id": "app-04-stop-whatsapp",
    "module": "general",
    "identity": "account",
    "screen": { "surface": "help" },
    "turns": ["How do I stop getting WhatsApp messages from you?"],
    "expect": {
      "tools": ["get_app_help"],
      "contains": ["STOP"]
    }
  },
  {
    "id": "app-05-turn-off-reminders",
    "module": "general",
    "identity": "guest",
    "screen": { "surface": "help" },
    "turns": ["How do I turn off the reminders BIA sends me?"],
    "expect": {
      "tools": ["get_app_help"],
      "contains": ["re:reminders from bia|profile"]
    }
  },
  {
    "id": "app-06-an-unknown-feature-isnt-invented",
    "module": "general",
    "identity": "account",
    "screen": { "surface": "help" },
    "turns": ["Where do I switch the app to dark mode?"],
    "expect": {
      "contains": ["re:not sure|isn.t|doesn.t|don.t (see|have|know)|no dark mode|can.t find|not (available|an option)"],
      "notContains": ["re:go to (the )?(dark|theme)|tap (on )?(dark|theme)|turn on (the )?dark|(under|in) (your |the )?(profile|menu|settings)[^.]{0,30}dark mode"]
    }
  },
  {
    "id": "app-07-what-can-bia-do",
    "module": "general",
    "identity": "anon",
    "screen": { "surface": "help" },
    "turns": ["Can you book a shipment for me?"],
    "expect": {
      "contains": ["re:can.t|cannot|not able"],
      "notContains": ["re:I('ll| will) book|I('ve| have) booked|booking (is )?confirmed"]
    }
  },
  {
    "id": "app-08-rewards-where",
    "module": "general",
    "identity": "account",
    "screen": { "surface": "help" },
    "turns": ["Where is the loyalty points section in the app?"],
    "expect": {
      "tools": ["get_app_help"],
      "contains": ["re:rewards"],
      "notContains": ["re:I('ll| will) (add|apply|use|redeem)"]
    }
  },
  {
    "id": "app-09-rewards-how-to-use",
    "module": "general",
    "identity": "account",
    "screen": { "surface": "help" },
    "turns": ["How do I use my reward points?"],
    "expect": {
      "tools": ["get_app_help"],
      "contains": ["re:review (&|and) pay", "re:100"],
      "notContains": ["re:I('ll| will) (apply|use|redeem)|I('ve| have) (applied|redeemed)"]
    }
  },
  {
    "id": "app-10-rewards-not-on-cod",
    "module": "general",
    "identity": "account",
    "screen": { "surface": "help" },
    "turns": ["Can I use my points if I pick cash on delivery?"],
    "expect": {
      "tools": ["get_app_help"],
      "contains": ["re:can.t|cannot|not with|isn.t|aren.t|no,"]
    }
  },
  {
    "id": "app-11-rewards-expiry",
    "module": "general",
    "identity": "account",
    "screen": { "surface": "help" },
    "turns": ["When do my reward points expire?"],
    "expect": {
      "tools": ["get_app_help"],
      "contains": ["re:30 mar"]
    }
  },
  {
    "id": "app-12-rewards-guest-doesnt-earn",
    "module": "general",
    "identity": "guest",
    "screen": { "surface": "help" },
    "turns": ["Do I get reward points for my booking?"],
    "expect": {
      "contains": ["re:account"],
      "notContains": ["re:you('ll| will) (earn|get) [0-9]+ points"]
    }
  },
  {
    "id": "app-13-rewards-no-invented-perks",
    "module": "general",
    "identity": "account",
    "screen": { "surface": "help" },
    "turns": ["What tier am I and what perks do I get?"],
    "expect": {
      "contains": ["re:no tiers|not yet|announced|special rewards"],
      "notContains": ["re:(gold|silver|platinum|bronze)|free (pickup|shipping)|% off"]
    }
  }
]
