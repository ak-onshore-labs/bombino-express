[
  {
    "id": "anon-01-pickup-covered",
    "ref": "#1",
    "module": "general",
    "identity": "anon",
    "turns": [
      "Can you pick up from 400053?"
    ],
    "expect": {
      "tools": [
        "check_pickup"
      ],
      "buttons": [
        "TAP_CREATE_SHIPMENT"
      ],
      "contains": [
        "7 PM"
      ],
      "cards": [
        "pickup"
      ]
    }
  },
  {
    "id": "anon-02-pickup-not-covered-bangalore",
    "ref": "#2",
    "module": "general",
    "identity": "anon",
    "turns": [
      "Is pickup available at 560001?"
    ],
    "expect": {
      "tools": [
        "check_pickup"
      ],
      "buttons": [
        "TAP_LOCATIONS:Karnataka"
      ],
      "contains": [
        "re:not (yet )?available|isn.t available|don.t (yet )?(offer|cover)"
      ],
      "cards": [
        "pickup"
      ]
    }
  },
  {
    "id": "anon-03-pickup-not-covered-mira-road",
    "ref": "#3",
    "module": "general",
    "identity": "anon",
    "turns": [
      "Is pickup available at 401107?"
    ],
    "expect": {
      "tools": [
        "check_pickup"
      ],
      "buttons": [
        "TAP_LOCATIONS:Maharashtra"
      ],
      "contains": [
        "re:not (yet )?available|isn.t available|don.t (yet )?(offer|cover)"
      ],
      "cards": [
        "pickup"
      ]
    }
  },
  {
    "id": "anon-04-rate-london",
    "ref": "#4",
    "module": "general",
    "identity": "anon",
    "turns": [
      "How much to send 2 kg to London?"
    ],
    "expect": {
      "tools": [
        "get_rates"
      ],
      "buttons": [
        "TAP_CREATE_SHIPMENT"
      ],
      "contains": [
        "₹",
        "re:estimate"
      ],
      "notContains": [
        "re:confirm the weight"
      ],
      "cards": [
        "rate"
      ]
    }
  },
  {
    "id": "anon-05-why-no-tracking-number",
    "ref": "#5",
    "module": "general",
    "identity": "anon",
    "turns": [
      "Why don't I have a tracking number yet?"
    ],
    "expect": {
      "toolsNot": [
        "get_order_status"
      ],
      "contains": [
        "re:weigh|hub"
      ],
      "notContains": [
        "re:please sign in|log in first"
      ]
    }
  },
  {
    "id": "anon-06-order-needs-sign-in",
    "ref": "#6",
    "module": "orders",
    "identity": "anon",
    "turns": [
      "Where is my order BOM-100001?"
    ],
    "expect": {
      "contains": [
        "re:sign(ed)? in|verify your phone"
      ],
      "buttonsNot": [
        "re:TAP_VIEW_ORDER"
      ],
      "notContains": [
        "re:arrived|picked up|awaiting drop-off|pickup confirmed"
      ],
      "noCards": true
    }
  },
  {
    "id": "anon-07-unknown-awb",
    "ref": "#7",
    "module": "general",
    "identity": "anon",
    "turns": [
      "track 123456789012"
    ],
    "expect": {
      "tools": [
        "get_tracking_summary"
      ],
      "contains": [
        "re:couldn.t find|could not find|no (tracking|record)"
      ],
      "quickReplies": "none",
      "noCards": true
    }
  },
  {
    "id": "anon-08-how-to-pay",
    "ref": "#8",
    "module": "general",
    "identity": "anon",
    "turns": [
      "How do I pay?"
    ],
    "expect": {
      "contains": [
        "re:rider",
        "re:counter|drop.?off",
        "re:deliver",
        "re:estimate"
      ]
    }
  }
]
