[
  {
    "id": "case-01-damaged-parcel-opens-a-case",
    "module": "handoff",
    "requires": ["handoff"],
    "identity": "guest",
    "screen": { "surface": "help" },
    "turns": ["My parcel BOM-100136 arrived with the box crushed and the vase inside broken. I want this sorted out."],
    "expect": {
      "tools": ["escalate_support"],
      "cards": ["case"],
      "contains": ["BIA-1001", "re:team"],
      "notContains": [
        "re:(within|in) (the next )?[0-9]+ (hours?|days?|business days?|working days?)|call you back|(will|shall) (call|contact|reach|get back to) you (back )?(within|by|today|tomorrow|shortly|soon)|24 hours|refund (has been|is) (approved|processed)|you will (get|receive) a refund"
      ],
      "buttons": ["TAP_CASE_WHATSAPP:BIA-1001"],
      "case": { "count": 1, "orderNo": "BOM-100136", "category": "damaged", "summaryContains": ["BOM-100136", "re:broke|crush|damag"] }
    }
  },
  {
    "id": "case-02-asking-again-finds-the-same-case",
    "module": "handoff",
    "requires": ["handoff"],
    "identity": "guest",
    "screen": { "surface": "help" },
    "turns": [
      "My parcel BOM-100136 arrived damaged, the vase is broken. I need someone to look at this.",
      "It really is broken. Please escalate it to your team again."
    ],
    "expect": {
      "contains": ["BIA-1001"],
      "notContains": ["BIA-1002"],
      "case": { "count": 1 }
    }
  },
  {
    "id": "case-03-a-person-about-a-refund",
    "module": "handoff",
    "requires": ["handoff"],
    "identity": "account",
    "screen": { "surface": "help" },
    "turns": ["I was charged twice for a booking and I want to speak to a person about a refund."],
    "expect": {
      "tools": ["escalate_support"],
      "cards": ["case"],
      "contains": ["re:BIA-[0-9]{4}"],
      "notContains": ["re:refund (has been|is|will be) (approved|processed|issued)|you will (get|receive) (your money|a refund)"],
      "case": { "count": 1, "category": "refund", "summaryContains": ["re:charged twice|double|twice|refund"] }
    }
  },
  {
    "id": "case-04-signed-out-gets-no-case",
    "module": "handoff",
    "requires": ["handoff"],
    "identity": "anon",
    "screen": { "surface": "help" },
    "turns": ["I want to speak to someone at Bombino."],
    "expect": {
      "notContains": ["re:BIA-[0-9]{4}|case (is|has been) (open|opened)"],
      "buttons": ["TAP_CONTACT_US"],
      "noCards": true,
      "case": { "count": 0 }
    }
  },
  {
    "id": "case-05-handoff-off-changes-nothing",
    "module": "general",
    "skipIf": ["handoff"],
    "identity": "guest",
    "screen": { "surface": "help" },
    "turns": ["My parcel BOM-100136 arrived damaged. I want to talk to your team."],
    "expect": {
      "notContains": ["re:BIA-[0-9]{4}|case (is|has been) (open|opened)|(have|has) (escalated|forwarded|passed on|raised)|someone will (call|contact|be in touch)"],
      "buttons": ["TAP_CONTACT_US"],
      "case": { "count": 0 }
    }
  },
  {
    "id": "case-06-the-bell-shows-our-reply",
    "module": "handoff",
    "requires": ["handoff"],
    "identity": "account",
    "screen": { "surface": "help" },
    "cases": [
      { "orderNo": "BOM-100108", "category": "rider", "reply": "We have spoken to the rider team. A rider will come for BOM-100108 on Monday between 10 am and 1 pm." }
    ],
    "turns": ["What did the team say on my case BIA-1001?"],
    "expect": {
      "tools": ["get_support_case"],
      "cards": ["case"],
      "contains": ["re:Monday"],
      "notContains": ["re:call you back|refund|I('ve| have) (arranged|scheduled|booked)"],
      "buttons": ["TAP_CASE_WHATSAPP:BIA-1001"]
    }
  },
  {
    "id": "case-07-no-reply-yet-promises-nothing",
    "module": "handoff",
    "requires": ["handoff"],
    "identity": "guest",
    "screen": { "surface": "help" },
    "cases": [{ "orderNo": "BOM-100136", "category": "damaged" }],
    "turns": ["Has your team replied on my case yet?"],
    "expect": {
      "tools": ["get_support_case"],
      "contains": ["BIA-1001", "re:not (yet )?(replied|answered|responded)|not yet|no reply|hasn.t (replied|answered|responded)|haven.t (replied|answered|responded)"],
      "notContains": [
        "re:(within|in) (the next )?[0-9]+ (hours?|days?|business days?|working days?)|24 hours|(will|shall) (reply|respond|get back|be in touch|contact you) (soon|shortly|today|tomorrow)"
      ]
    }
  },
  {
    "id": "case-08-someone-elses-case-number",
    "module": "handoff",
    "requires": ["handoff"],
    "identity": "guest",
    "screen": { "surface": "help" },
    "turns": ["What's happening with case BIA-1005?"],
    "expect": {
      "tools": ["get_support_case"],
      "noCards": true,
      "notContains": ["re:(is|was) (open|answered|closed)|our team replied"]
    }
  }
]
